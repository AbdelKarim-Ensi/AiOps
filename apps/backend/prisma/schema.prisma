// Schéma Prisma — équivalent conceptuel des entités TypeORM que tu connais peut-être,
// mais Prisma génère un client TypeScript entièrement typé à partir de ce fichier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum = équivalent d'un type union TypeScript, mais persisté en base
enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  tasks     Task[]   // relation one-to-many : un User a plusieurs Task
  createdAt DateTime @default(now())
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    // "?" = champ optionnel, comme "description?: string" en TS
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?

  // Clé étrangère explicite vers User — équivalent d'un @ManyToOne + @JoinColumn en TypeORM
  owner       User?      @relation(fields: [ownerId], references: [id])
  ownerId     String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
model Anomaly {
  id                   String   @id @default(uuid())
  windowStart          DateTime
  windowEnd            DateTime

  totalLogs            Int
  errorCount           Int
  distinctUrls         Int
  simulateFailureCount Int
  errorRate            Float
  anomalyScore         Float

  isFalsePositive      Boolean  @default(false)

  createdAt            DateTime @default(now())

  @@index([windowStart])
  @@index([createdAt])
}